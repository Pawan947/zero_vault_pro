# Runtime
NODE_ENV=development
PORT=3000

# Sessions and encryption — generate strong, independent values
SESSION_SECRET=replace_with_a_long_random_session_secret
STORAGE_MASTER_KEY=replace_with_a_long_random_storage_master_key

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# S3-compatible storage (Wasabi/AWS S3)
WASABI_ACCESS_KEY_ID=your_storage_access_key
WASABI_SECRET_ACCESS_KEY=your_storage_secret_key
WASABI_BUCKET=your_bucket_name
WASABI_REGION=us-east-1

# WebAuthn
UNIVERSAL_API_KEY=replace_with_a_random_server_side_value
RP_ID=localhost
ORIGIN=http://localhost:3000
